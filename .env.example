# 复制为 .env 后按实际填写（docker-compose 自动读取）

# 工单系统对外 HTTPS 地址（webhook 注册与消息跳转链接用）
PUBLIC_BASE_URL=https://ticket.example.com

# sub2api 站点地址
SUB2API_BASE_URL=https://api.example.com

# sub2api 管理后台 → 系统设置 → 管理员 API Key
SUB2API_ADMIN_API_KEY=

# 与 sub2api 不在同一主域时（iframe 跨站）必须 none + HTTPS
COOKIE_SAMESITE=none

# 本地兜底管理员（可选，首次启动创建；SSO 链路故障时可在 /login 登录）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# 本地调试 TG 时可设 true（long polling，无需公网）
TG_POLLING=false

# 服务器无法直连 api.telegram.org 时必填（http:// 或 socks5://）
TG_PROXY=
